# Modelo do arquivo de configuracao. Copie para "configuracao.env" e preencha.

# API do SGA (Hinova): token gerado em Area Cliente > APIs > Gerenciar APIs
SGA_TOKEN=
SGA_USUARIO=
SGA_SENHA=
SGA_API_URL=https://api.hinova.com.br/api/sga/v2
SGA_DATA_INICIAL=01/01/2020

# Arquivos
PLANILHA_SINISTRO=RESULTADOS\GERENCIAL SINISTRO.xlsx
PLANILHA_BASE=
PASTA_ENTRADA=ENTRADA
BACKUPS_MANTER=7

# ---------------------------------------------------------------- Planilhas dos setores
# Geradas a partir da aba SIGA do sinistro. Deixe em branco a que nao quiser gerar.
PLANILHA_ANALISTAS=RESULTADOS\ANALISTAS.xlsx
PLANILHA_CONSULTORES=RESULTADOS\CONSULTORES TECNICOS.xlsx
PLANILHA_REGULADORES=RESULTADOS\REGULADORES.xlsx

# Planilhas baixadas do Google Sheets. So sao lidas na PRIMEIRA vez que cada planilha acima e
# criada, para trazer o que as equipes ja digitaram (observacoes, regularizado por, oficinas...).
PLANILHA_BASE_ANALISTAS=
PLANILHA_BASE_CONSULTORES=
PLANILHA_BASE_REGULADORES=

# ---------------------------------------------------------------- Pagina da conferencia de finalizados
# Pagina HTML (abre no navegador) com os eventos do SIGA liberados e a situacao de cada um no SGA.
# Deixe em branco para nao gerar. Contem dados de associados: uso interno.
PAINEL_FINALIZADOS=RESULTADOS\CONFERENCIA FINALIZADOS.html
# Mostrar eventos liberados a partir desta data (dd/mm/aaaa)
PAINEL_FINALIZADOS_DESDE=01/01/2025

# ---------------------------------------------------------------- Pagina de acompanhamento dos analistas
# Pagina HTML onde os analistas preenchem situacao, proxima acao, prazo e observacao dos processos
# das abas ANALISTAS e VIDROS. O botao "Salvar alteracoes" da pagina grava um arquivo que deve ir
# para a pasta ENTRADA; a atualizacao seguinte le o arquivo. Deixe em branco para nao gerar.
PAGINA_ACOMPANHAMENTO=RESULTADOS\ACOMPANHAMENTO ANALISTAS.html
# O sistema tambem procura esses arquivos na pasta Downloads do usuario (onde o navegador costuma
# salvar). Sem esta linha, usa a pasta Downloads do Windows; com ela em branco, nao procura.
# PASTA_DOWNLOADS=C:\Users\nome\Downloads

# ---------------------------------------------------------------- Pastas extras de relatorios
# Pastas onde o sistema tambem procura relatorios do SIGA e do SGA. Os reconhecidos sao copiados para a
# ENTRADA; os originais nao sao tocados e cada arquivo e copiado uma so vez. Separe varias por ponto-e-virgula.
PASTAS_ENTRADA_EXTRA=

# ---------------------------------------------------------------- SIGA (Arco Consultoria)
# O SIGA nao tem API publica: os eventos vem do DashBoard exportado (um arquivo por ano) e salvo
# na pasta ENTRADA. A rotina avisa no log quais anos, deste ate o atual, ainda nao foram trazidos.
SIGA_ANO_INICIAL=2021

# ---------------------------------------------------------------- Registro de exportacoes
# Arquivo de texto com cada dado que entrou no sistema e se foi MANUAL ou AUTOMATICO.
REGISTRO_EXPORTACOES=RESULTADOS\REGISTRO DE EXPORTACOES.txt

# ---------------------------------------------------------------- Google Sheets
# Chave JSON da conta de servico (Google Cloud > IAM > Contas de servico > Chaves). Cada planilha abaixo
# precisa estar compartilhada, como Editor, com o e-mail da conta de servico.
GOOGLE_CREDENCIAIS=
# Link (ou codigo) de cada planilha. A que estiver preenchida passa a ser a de trabalho: o sistema le e
# grava nela, e nao no .xlsx correspondente de RESULTADOS. Deixe em branco para continuar no .xlsx.
GOOGLE_SINISTRO=
GOOGLE_ANALISTAS=
GOOGLE_CONSULTORES=
GOOGLE_REGULADORES=

# ---------------------------------------------------------------- Site dos paineis (Vercel)
# O envio para o site acontece AUTOMATICAMENTE ao fim de cada atualizacao, quando estes
# dois campos estao preenchidos. Tambem da para enviar na hora com "Enviar paineis para o site.bat".
# Deixe em branco para nao enviar nada para o site.
VERCEL_SITE_URL=
# O MESMO valor que voce definir em UPLOAD_SECRET nas variaveis de ambiente da Vercel.
VERCEL_UPLOAD_SECRET=
