# ----------------------------------------------------------------------------
# Variaveis de ambiente do site dos paineis (Grupo Support) na Vercel.
# No painel da Vercel: Project > Settings > Environment Variables.
# Para testar na sua maquina, copie este arquivo para ".env" e preencha.
# ----------------------------------------------------------------------------

# Senha que a ferramenta local usa para ENVIAR os paineis (o upload).
# Invente um texto longo e aleatorio. A mesma senha vai no configuracao.env
# da ferramenta, no campo VERCEL_UPLOAD_SECRET.
UPLOAD_SECRET=

# Usuario e senha para ABRIR os paineis no navegador (protege os dados dos
# associados). Quem acessar o site vai precisar digitar isto.
VIEW_USER=support
VIEW_PASSWORD=

# Criado AUTOMATICAMENTE pela Vercel quando voce adiciona um Blob Store ao
# projeto (Storage > Create > Blob). Nao precisa preencher a mao na Vercel;
# so e necessario aqui se for testar localmente com "vercel dev".
# BLOB_READ_WRITE_TOKEN=
