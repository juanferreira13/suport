{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/finalizados", "destination": "/api/finalizados" },
    { "source": "/acompanhamento", "destination": "/api/acompanhamento" }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  }
}
